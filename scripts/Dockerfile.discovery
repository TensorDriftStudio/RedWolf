# ==============================================================================
# RedWolf Bare-Metal & VM Provisioning Engine
# Discovery RAMdisk Builder (Alpine Linux 3.20 + Linux LTS Kernel)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Static Discovery Go Binary
# ------------------------------------------------------------------------------
FROM golang:1.23-alpine AS agent-builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ ./cmd/
COPY internal/ ./internal/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /bin/redwolf-discovery ./cmd/redwolf-discovery

# ------------------------------------------------------------------------------
# Stage 2: Assemble Alpine RAMdisk Root Filesystem
# ------------------------------------------------------------------------------
FROM alpine:3.20 AS ramfs-builder

# Install required system packages, enterprise network/storage drivers & utilities
RUN apk update && apk add --no-cache \
    linux-lts \
    util-linux \
    ipmitool \
    gptfdisk \
    parted \
    dosfstools \
    efibootmgr \
    pciutils \
    usbutils \
    dmidecode \
    ethtool \
    e2fsprogs \
    xfsprogs \
    mdadm \
    lvm2 \
    ca-certificates \
    curl \
    zstd \
    kmod \
    cpio \
    gzip \
    pigz

# Create staging ramdisk hierarchy
WORKDIR /staging
RUN mkdir -p \
    /staging/bin \
    /staging/sbin \
    /staging/usr/bin \
    /staging/usr/sbin \
    /staging/usr/lib \
    /staging/usr/local/bin \
    /staging/etc \
    /staging/proc \
    /staging/sys \
    /staging/dev \
    /staging/tmp \
    /staging/run \
    /staging/var/log \
    /staging/var/run \
    /staging/lib \
    /staging/mnt/redwolf-target \
    /staging/root

# Create static essential device nodes
RUN mknod -m 600 /staging/dev/console c 5 1 && \
    mknod -m 666 /staging/dev/null c 1 3 && \
    mknod -m 666 /staging/dev/zero c 1 5 && \
    mknod -m 666 /staging/dev/tty c 5 0 && \
    mknod -m 620 /staging/dev/tty1 c 4 1

# Populate system utilities and musl dynamic libraries
RUN cp -a /bin/* /staging/bin/ && \
    cp -a /sbin/* /staging/sbin/ && \
    cp -a /usr/bin/* /staging/usr/bin/ && \
    cp -a /usr/sbin/* /staging/usr/sbin/ && \
    cp -a /lib/* /staging/lib/ && \
    cp -a /usr/lib/* /staging/usr/lib/ && \
    ( [ -d /lib64 ] && mkdir -p /staging/lib64 && cp -a /lib64/* /staging/lib64/ || true ) && \
    ( [ -d /usr/lib64 ] && mkdir -p /staging/usr/lib64 && cp -a /usr/lib64/* /staging/usr/lib64/ || true ) && \
    cp -a /etc/* /staging/etc/ && \
    mkdir -p /staging/usr/share/udhcpc && \
    cp -a /usr/share/udhcpc/* /staging/usr/share/udhcpc/

# Strip large consumer wireless/GPU/audio firmware, retaining server NIC and storage firmware
RUN if [ -d /staging/lib/firmware ]; then \
        rm -rf /staging/lib/firmware/amdgpu \
               /staging/lib/firmware/radeon \
               /staging/lib/firmware/nvidia \
               /staging/lib/firmware/intel \
               /staging/lib/firmware/iwlwifi* \
               /staging/lib/firmware/ath* \
               /staging/lib/firmware/rtlwifi \
               /staging/lib/firmware/rtw88 \
               /staging/lib/firmware/rtw89 \
               /staging/lib/firmware/brcm \
               /staging/lib/firmware/mediatek \
               /staging/lib/firmware/mrvl \
               /staging/lib/firmware/liquidio \
               /staging/lib/firmware/netronome \
               /staging/lib/firmware/qcom \
               /staging/lib/firmware/inside-secure \
               /staging/lib/firmware/nxp \
               /staging/lib/firmware/ti* \
               /staging/usr/share/doc \
               /staging/usr/share/man \
               /staging/usr/share/zoneinfo; \
    fi

# Copy Linux LTS kernel modules and prune non-server drivers to optimize PXE boot payload
RUN for kdir in /staging/lib/modules/*; do \
        [ -d "$kdir" ] || continue; \
        KVER=$(basename "$kdir"); \
        rm -rf "$kdir/kernel/sound" \
               "$kdir/kernel/net/wireless" \
               "$kdir/kernel/drivers/gpu" \
               "$kdir/kernel/drivers/media" \
               "$kdir/kernel/drivers/bluetooth" \
               "$kdir/kernel/drivers/sound"; \
        depmod -b /staging "${KVER}"; \
    done

# Install static Go discovery binary
COPY --from=agent-builder /bin/redwolf-discovery /staging/usr/local/bin/redwolf-discovery
RUN chmod 755 /staging/usr/local/bin/redwolf-discovery

# Install PID 1 /init script
COPY scripts/init.sh /staging/init
RUN chmod 755 /staging/init

# Create output artifacts directory
RUN mkdir -p /output

# Export Linux LTS kernel
RUN cp /boot/vmlinuz-lts /output/vmlinuz

# Pack cpio gzip initramfs archive with parallel multi-core compression and generate checksums
RUN cd /staging && \
    find . | cpio -H newc -o | pigz -p $(nproc) > /output/initramfs.img && \
    cp /output/initramfs.img /output/initramfs.cpio.gz && \
    cd /output && \
    sha256sum vmlinuz initramfs.img > SHA256SUMS

# ------------------------------------------------------------------------------
# Stage 3: Artifact Distribution Container
# ------------------------------------------------------------------------------
FROM alpine:3.20
COPY --from=ramfs-builder /output /output
VOLUME ["/output"]
CMD ["cp", "-a", "/output/.", "/target/"]
